# Copie para backend/.env (o arquivo .env não vai para o git).
# Sem client id/secret a porta permanece desligada. Com os dois preenchidos,
# o app pede Google/Outlook sozinho — a menos que AUTH_MODO=desligado.

AUTH_MODO=desligado
AUTH_SECRET=troque-por-uma-string-longa
AUTH_URL_PUBLICA=http://localhost:5173
AUTH_COOKIE_SECURE=0
# E-mail na lista ou domínio. Vírgula e espaço são aceitos.
# AUTH_DOMINIOS=projecont.com.br
# AUTH_EMAILS=ryan@pktech.ai, pessoa@gmail.com

# Google Cloud → APIs e serviços → Tela de consentimento + ID do cliente OAuth
# Origem: http://localhost:5173
# Redirect: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure → Registro de aplicativo → plataforma Web (não SPA)
# Redirect: http://localhost:5173/api/auth/callback/microsoft
# Segredos do cliente: cole o Valor (aparece uma vez). Não cole o Secret ID (é um GUID).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
